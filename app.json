{
  "expo": {
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "name": "¿Me alcanza?",
    "slug": "projects",
    "version": "1.0.0",
    "description": "Tu número diario para gastar sin arruinar el mes. Local, privado y sin cuentas.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mealcanza",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.andresea2605.mealcanza",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.andresea2605.mealcanza",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#1046C4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1046C4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 132
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir una imagen para identificar tus productos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7cc669d4-a1d1-41e1-b7a3-334605fb2d48"
      }
    },
    "owner": "dreasys-team"
  }
}
